{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered EarnMore India user profile with verification, referral code, language, and consent metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "referralCode": { "type": "string" },
        "referredByUid": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "kycStatus": { "type": "string", "enum": ["UNVERIFIED", "PENDING", "VERIFIED"] },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi"] },
        "consentAccepted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "displayName", "email", "role", "referralCode", "isVerified", "kycStatus", "preferredLanguage", "consentAccepted", "createdAt", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User earning wallet summary. Balance mutations are restricted from regular client writes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "availableBalanceInr": { "type": "number" },
        "pendingBalanceInr": { "type": "number" },
        "totalEarnedInr": { "type": "number" },
        "totalWithdrawnInr": { "type": "number" },
        "completedTasksCount": { "type": "integer" },
        "activeProjectsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "availableBalanceInr", "pendingBalanceInr", "totalEarnedInr", "totalWithdrawnInr", "completedTasksCount", "activeProjectsCount", "createdAt", "updatedAt"]
    },
    "LedgerTransaction": {
      "title": "LedgerTransaction",
      "description": "Immutable financial transaction ledger entry with transparent gross, commission, gateway fee, and net breakdown.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["CREDIT_TASK", "CREDIT_FREELANCE", "CREDIT_PRODUCT", "CREDIT_AFFILIATE", "CREDIT_REFERRAL", "CREDIT_TEACHING", "CREDIT_SERVICE", "DEBIT_WITHDRAWAL", "REFUND"] },
        "category": { "type": "string" },
        "grossAmountInr": { "type": "number" },
        "platformCommissionInr": { "type": "number" },
        "gatewayFeeInr": { "type": "number" },
        "netAmountInr": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "VERIFIED", "REVERSED"] },
        "referenceId": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "description": { "type": "string" },
        "isTestMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "category", "grossAmountInr", "platformCommissionInr", "gatewayFeeInr", "netAmountInr", "status", "referenceId", "idempotencyKey", "description", "isTestMode", "createdAt"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Payout withdrawal request in TEST MODE or compliant Indian UPI/Bank architecture (no PINs or passwords stored).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amountInr": { "type": "number" },
        "payoutMethod": { "type": "string", "enum": ["UPI_TEST", "BANK_TEST"] },
        "maskedDestination": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "PAID_TEST", "REJECTED", "CANCELLED"] },
        "isTestMode": { "type": "boolean" },
        "reviewNote": { "type": "string" },
        "reviewedByAdminId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amountInr", "payoutMethod", "maskedDestination", "status", "isTestMode", "createdAt", "updatedAt"]
    },
    "CommissionConfig": {
      "title": "CommissionConfig",
      "description": "Admin-configurable platform commission, gateway charge, and operating cost percentages per marketplace category.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["TASKS", "FREELANCE", "PRODUCTS", "AFFILIATE", "TEACHING", "SERVICES"] },
        "commissionPercent": { "type": "number" },
        "gatewayFeePercent": { "type": "number" },
        "operatingCostPercent": { "type": "number" },
        "isActive": { "type": "boolean" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "commissionPercent", "gatewayFeePercent", "operatingCostPercent", "isActive", "updatedByUid", "updatedAt"]
    },
    "MicroTask": {
      "title": "MicroTask",
      "description": "Genuine microtask listing (data entry, content writing, image tagging, web testing, research).",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleHi": { "type": "string" },
        "category": { "type": "string", "enum": ["DATA_ENTRY", "CONTENT_WRITING", "IMAGE_CATEGORIZATION", "WEBSITE_TESTING", "RESEARCH", "GAME_TASK"] },
        "description": { "type": "string" },
        "rewardGrossInr": { "type": "number" },
        "commissionPercent": { "type": "number" },
        "workerNetInr": { "type": "number" },
        "slotsTotal": { "type": "integer" },
        "slotsFilled": { "type": "integer" },
        "status": { "type": "string", "enum": ["OPEN", "PAUSED", "CLOSED"] },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "description", "rewardGrossInr", "commissionPercent", "workerNetInr", "slotsTotal", "slotsFilled", "status", "createdByUid", "createdAt", "updatedAt"]
    },
    "TaskSubmission": {
      "title": "TaskSubmission",
      "description": "Worker submission for a microtask with proof text/URL and admin approval state.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "userId": { "type": "string" },
        "proofText": { "type": "string" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["SUBMITTED", "APPROVED", "REJECTED"] },
        "reviewNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["taskId", "userId", "proofText", "status", "createdAt", "updatedAt"]
    },
    "FreelanceGig": {
      "title": "FreelanceGig",
      "description": "Freelance service offering (design, video editing, typing, translation, web dev, writing).",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "category": { "type": "string", "enum": ["GRAPHIC_DESIGN", "VIDEO_EDITING", "LOGO_DESIGN", "TYPING", "TRANSLATION", "WEB_DEVELOPMENT", "WRITING"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priceInr": { "type": "number" },
        "deliveryDays": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "sellerName", "category", "title", "description", "priceInr", "deliveryDays", "isActive", "createdAt", "updatedAt"]
    },
    "FreelanceOrder": {
      "title": "FreelanceOrder",
      "description": "Freelance order with transparent platform commission and TEST MODE payment state.",
      "type": "object",
      "properties": {
        "gigId": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "grossAmountInr": { "type": "number" },
        "platformCommissionInr": { "type": "number" },
        "sellerNetInr": { "type": "number" },
        "requirements": { "type": "string" },
        "deliveryNote": { "type": "string" },
        "status": { "type": "string", "enum": ["PLACED", "IN_PROGRESS", "DELIVERED", "COMPLETED", "DISPUTED", "CANCELLED"] },
        "isTestMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gigId", "buyerId", "sellerId", "grossAmountInr", "platformCommissionInr", "sellerNetInr", "requirements", "status", "isTestMode", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Marketplace product listing.",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priceInr": { "type": "number" },
        "stock": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "sellerName", "category", "title", "description", "priceInr", "stock", "isActive", "createdAt", "updatedAt"]
    },
    "ProductOrder": {
      "title": "ProductOrder",
      "description": "Product marketplace order with seller commission and tracking state.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "quantity": { "type": "integer" },
        "grossAmountInr": { "type": "number" },
        "platformCommissionInr": { "type": "number" },
        "sellerNetInr": { "type": "number" },
        "shippingArea": { "type": "string" },
        "trackingStatus": { "type": "string", "enum": ["ORDERED", "PACKED", "SHIPPED", "DELIVERED", "COMPLETED", "CANCELLED"] },
        "isTestMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "buyerId", "sellerId", "quantity", "grossAmountInr", "platformCommissionInr", "sellerNetInr", "shippingArea", "trackingStatus", "isTestMode", "createdAt", "updatedAt"]
    },
    "AffiliateOffer": {
      "title": "AffiliateOffer",
      "description": "Genuine merchant affiliate campaign.",
      "type": "object",
      "properties": {
        "merchantName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "baseUrl": { "type": "string" },
        "totalCommissionPercent": { "type": "number" },
        "userSharePercent": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["merchantName", "title", "category", "baseUrl", "totalCommissionPercent", "userSharePercent", "isActive", "createdAt"]
    },
    "AffiliateEvent": {
      "title": "AffiliateEvent",
      "description": "Unique affiliate link tracking and verified sale conversion record.",
      "type": "object",
      "properties": {
        "offerId": { "type": "string" },
        "promoterUid": { "type": "string" },
        "trackingCode": { "type": "string" },
        "status": { "type": "string", "enum": ["CLICKED", "VERIFIED_SALE", "REJECTED"] },
        "saleAmountInr": { "type": "number" },
        "grossCommissionInr": { "type": "number" },
        "userPayoutInr": { "type": "number" },
        "platformNetInr": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["offerId", "promoterUid", "trackingCode", "status", "saleAmountInr", "grossCommissionInr", "userPayoutInr", "platformNetInr", "createdAt", "updatedAt"]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Single-tier anti-MLM referral tracking unlocked only on verified eligible activity.",
      "type": "object",
      "properties": {
        "referrerUid": { "type": "string" },
        "refereeUid": { "type": "string" },
        "referralCode": { "type": "string" },
        "status": { "type": "string", "enum": ["SIGNED_UP", "ELIGIBLE_ACTIVITY_DONE", "REWARDED", "FLAGGED"] },
        "rewardInr": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referrerUid", "refereeUid", "referralCode", "status", "rewardInr", "createdAt", "updatedAt"]
    },
    "TutorCourse": {
      "title": "TutorCourse",
      "description": "Online tutoring or skill-based course listing.",
      "type": "object",
      "properties": {
        "tutorId": { "type": "string" },
        "tutorName": { "type": "string" },
        "subject": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "hourlyRateInr": { "type": "number" },
        "mode": { "type": "string", "enum": ["LIVE_1ON1", "COHORT_CLASS", "SKILL_COURSE"] },
