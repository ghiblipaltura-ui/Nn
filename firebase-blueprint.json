        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "reason", "severity", "status", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Authoritative RBAC marker doc granting admin access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
