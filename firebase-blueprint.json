        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tutorId", "tutorName", "subject", "title", "description", "hourlyRateInr", "mode", "isActive", "createdAt", "updatedAt"]
    },
    "TutorBooking": {
      "title": "TutorBooking",
      "description": "Booking record for a tutoring session or skill course.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "studentId": { "type": "string" },
        "tutorId": { "type": "string" },
        "scheduledSlot": { "type": "string" },
        "grossAmountInr": { "type": "number" },
        "platformCommissionInr": { "type": "number" },
        "tutorNetInr": { "type": "number" },
        "status": { "type": "string", "enum": ["BOOKED", "CONFIRMED", "COMPLETED", "CANCELLED"] },
        "isTestMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "studentId", "tutorId", "scheduledSlot", "grossAmountInr", "platformCommissionInr", "tutorNetInr", "status", "isTestMode", "createdAt", "updatedAt"]
    },
    "LocalService": {
      "title": "LocalService",
      "description": "Local Indian hyperlocal service provider listing.",
      "type": "object",
      "properties": {
        "providerId": { "type": "string" },
        "providerName": { "type": "string" },
        "serviceType": { "type": "string" },
        "city": { "type": "string" },
        "description": { "type": "string" },
        "rateInr": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["providerId", "providerName", "serviceType", "city", "description", "rateInr", "isActive", "createdAt", "updatedAt"]
    },
    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "Local service booking with mutual customer completion confirmation.",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string" },
        "customerId": { "type": "string" },
        "providerId": { "type": "string" },
        "cityArea": { "type": "string" },
        "notes": { "type": "string" },
        "grossAmountInr": { "type": "number" },
        "platformCommissionInr": { "type": "number" },
        "providerNetInr": { "type": "number" },
        "customerConfirmed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["REQUESTED", "ACCEPTED", "WORK_DONE", "COMPLETED", "CANCELLED"] },
        "isTestMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["serviceId", "customerId", "providerId", "cityArea", "grossAmountInr", "platformCommissionInr", "providerNetInr", "customerConfirmed", "status", "isTestMode", "createdAt", "updatedAt"]
    },
    "DisputeRefund": {
      "title": "DisputeRefund",
      "description": "Order dispute and refund ticket.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "relatedOrderId": { "type": "string" },
        "category": { "type": "string" },
        "reason": { "type": "string" },
        "requestedRefundInr": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "UNDER_REVIEW", "REFUNDED", "REJECTED"] },
        "adminResolutionNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "relatedOrderId", "category", "reason", "requestedRefundInr", "status", "createdAt", "updatedAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support inquiry ticket.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "RESOLVED"] },
        "adminReply": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "message", "category", "status", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Admin-only immutable audit trail of sensitive platform and financial actions.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "action": { "type": "string" },
        "targetPath": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "targetPath", "summary", "createdAt"]
    },
    "FraudFlag": {
      "title": "FraudFlag",
      "description": "Anti-fraud anomaly record for admin investigation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reason": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "status": { "type": "string", "enum": ["OPEN", "CLEARED", "BLOCKED"] },
