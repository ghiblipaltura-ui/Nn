        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "ownerUid", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": { "schema": { "$ref": "#/entities/AdminMarker" }, "description": "RBAC admin markers" },
    "/referral_codes/{code}": { "schema": { "$ref": "#/entities/ReferralCodeLookup" }, "description": "PII-free referral code directory" },
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" }, "description": "User profiles" },
    "/wallets/{userId}": { "schema": { "$ref": "#/entities/Wallet" }, "description": "User wallets" },
    "/ledger_transactions/{txId}": { "schema": { "$ref": "#/entities/LedgerTransaction" }, "description": "Immutable financial ledger" },
    "/withdrawal_requests/{reqId}": { "schema": { "$ref": "#/entities/WithdrawalRequest" }, "description": "User withdrawal requests" },
    "/commission_configs/{categoryId}": { "schema": { "$ref": "#/entities/CommissionConfig" }, "description": "Category commission settings" },
    "/tasks/{taskId}": { "schema": { "$ref": "#/entities/MicroTask" }, "description": "Daily microtasks" },
    "/task_submissions/{submissionId}": { "schema": { "$ref": "#/entities/TaskSubmission" }, "description": "Microtask submissions" },
    "/freelance_gigs/{gigId}": { "schema": { "$ref": "#/entities/FreelanceGig" }, "description": "Freelance gig listings" },
    "/freelance_orders/{orderId}": { "schema": { "$ref": "#/entities/FreelanceOrder" }, "description": "Freelance orders" },
    "/products/{productId}": { "schema": { "$ref": "#/entities/Product" }, "description": "Product marketplace listings" },
    "/product_orders/{orderId}": { "schema": { "$ref": "#/entities/ProductOrder" }, "description": "Product marketplace orders" },
    "/affiliate_offers/{offerId}": { "schema": { "$ref": "#/entities/AffiliateOffer" }, "description": "Affiliate offers" },
    "/affiliate_events/{eventId}": { "schema": { "$ref": "#/entities/AffiliateEvent" }, "description": "Affiliate link tracking and conversions" },
    "/referrals/{referralId}": { "schema": { "$ref": "#/entities/ReferralRecord" }, "description": "Single-tier referral records" },
    "/tutor_courses/{courseId}": { "schema": { "$ref": "#/entities/TutorCourse" }, "description": "Tutoring & skill courses" },
    "/tutor_bookings/{bookingId}": { "schema": { "$ref": "#/entities/TutorBooking" }, "description": "Tutoring bookings" },
    "/local_services/{serviceId}": { "schema": { "$ref": "#/entities/LocalService" }, "description": "Local service listings" },
    "/service_bookings/{bookingId}": { "schema": { "$ref": "#/entities/ServiceBooking" }, "description": "Local service bookings" },
    "/disputes_refunds/{disputeId}": { "schema": { "$ref": "#/entities/DisputeRefund" }, "description": "Disputes and refund requests" },
    "/support_tickets/{ticketId}": { "schema": { "$ref": "#/entities/SupportTicket" }, "description": "Support tickets" },
    "/audit_logs/{logId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Admin audit logs" },
    "/fraud_flags/{flagId}": { "schema": { "$ref": "#/entities/FraudFlag" }, "description": "Anti-fraud flags" }
  }
}
