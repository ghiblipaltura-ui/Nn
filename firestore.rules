rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'dashnitin110@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // --- Validation Blueprints ---

    function isValidAdminMarker(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidOptionalString(data, 'phone', 20) &&
        data.role in ['USER', 'ADMIN'] &&
        data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 24 &&
        isValidOptionalString(data, 'referredByUid', 128) &&
        data.isVerified is bool &&
        data.kycStatus in ['UNVERIFIED', 'PENDING', 'VERIFIED'] &&
        data.preferredLanguage in ['en', 'hi'] &&
        data.consentAccepted is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidWallet(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        (data.availableBalanceInr is int || data.availableBalanceInr is float) && data.availableBalanceInr >= 0 &&
        (data.pendingBalanceInr is int || data.pendingBalanceInr is float) && data.pendingBalanceInr >= 0 &&
        (data.totalEarnedInr is int || data.totalEarnedInr is float) && data.totalEarnedInr >= 0 &&
        (data.totalWithdrawnInr is int || data.totalWithdrawnInr is float) && data.totalWithdrawnInr >= 0 &&
        data.completedTasksCount is int && data.completedTasksCount >= 0 &&
        data.activeProjectsCount is int && data.activeProjectsCount >= 0 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidLedgerTransaction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.type in ['CREDIT_TASK', 'CREDIT_FREELANCE', 'CREDIT_PRODUCT', 'CREDIT_AFFILIATE', 'CREDIT_REFERRAL', 'CREDIT_TEACHING', 'CREDIT_SERVICE', 'CREDIT_PROMO', 'DEBIT_WITHDRAWAL', 'REFUND'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
        (data.grossAmountInr is int || data.grossAmountInr is float) && data.grossAmountInr >= 0 &&
        (data.platformCommissionInr is int || data.platformCommissionInr is float) && data.platformCommissionInr >= 0 &&
        (data.gatewayFeeInr is int || data.gatewayFeeInr is float) && data.gatewayFeeInr >= 0 &&
        (data.netAmountInr is int || data.netAmountInr is float) && data.netAmountInr >= 0 &&
        data.status in ['PENDING', 'VERIFIED', 'REVERSED'] &&
        data.referenceId is string && data.referenceId.size() >= 1 && data.referenceId.size() <= 128 &&
        data.idempotencyKey is string && data.idempotencyKey.size() >= 4 && data.idempotencyKey.size() <= 128 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 240 &&
        data.isTestMode is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidWithdrawalRequest(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        (data.amountInr is int || data.amountInr is float) && data.amountInr >= 100 && data.amountInr <= 50000 &&
        data.payoutMethod in ['UPI_TEST', 'BANK_TEST'] &&
        data.maskedDestination is string && data.maskedDestination.size() >= 3 && data.maskedDestination.size() <= 80 &&
        data.status in ['PENDING', 'APPROVED', 'PAID_TEST', 'REJECTED', 'CANCELLED'] &&
        data.isTestMode is bool &&
        isValidOptionalString(data, 'reviewNote', 240) &&
        isValidOptionalString(data, 'reviewedByAdminId', 128) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidCommissionConfig(data) {
      return data.category in ['TASKS', 'FREELANCE', 'PRODUCTS', 'AFFILIATE', 'TEACHING', 'SERVICES'] &&
        (data.commissionPercent is int || data.commissionPercent is float) && data.commissionPercent >= 0 && data.commissionPercent <= 50 &&
        (data.gatewayFeePercent is int || data.gatewayFeePercent is float) && data.gatewayFeePercent >= 0 && data.gatewayFeePercent <= 10 &&
        (data.operatingCostPercent is int || data.operatingCostPercent is float) && data.operatingCostPercent >= 0 && data.operatingCostPercent <= 20 &&
        data.isActive is bool &&
        data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidMicroTask(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        isValidOptionalString(data, 'titleHi', 140) &&
        data.category in ['DATA_ENTRY', 'CONTENT_WRITING', 'IMAGE_CATEGORIZATION', 'WEBSITE_TESTING', 'RESEARCH', 'GAME_TASK'] &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        (data.rewardGrossInr is int || data.rewardGrossInr is float) && data.rewardGrossInr > 0 && data.rewardGrossInr <= 10000 &&
        (data.commissionPercent is int || data.commissionPercent is float) && data.commissionPercent >= 0 && data.commissionPercent <= 50 &&
        (data.workerNetInr is int || data.workerNetInr is float) && data.workerNetInr > 0 && data.workerNetInr <= data.rewardGrossInr &&
        data.slotsTotal is int && data.slotsTotal >= 1 && data.slotsTotal <= 10000 &&
        data.slotsFilled is int && data.slotsFilled >= 0 && data.slotsFilled <= data.slotsTotal &&
        data.status in ['OPEN', 'PAUSED', 'CLOSED'] &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidTaskSubmission(data) {
      return data.taskId is string && isValidId(data.taskId) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.proofText is string && data.proofText.size() >= 3 && data.proofText.size() <= 1000 &&
        isValidOptionalString(data, 'proofUrl', 400) &&
        data.status in ['SUBMITTED', 'APPROVED', 'REJECTED'] &&
        isValidOptionalString(data, 'reviewNote', 240) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFreelanceGig(data) {
      return data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128 &&
        data.sellerName is string && data.sellerName.size() >= 2 && data.sellerName.size() <= 80 &&
        data.category in ['GRAPHIC_DESIGN', 'VIDEO_EDITING', 'LOGO_DESIGN', 'TYPING', 'TRANSLATION', 'WEB_DEVELOPMENT', 'WRITING'] &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1200 &&
        (data.priceInr is int || data.priceInr is float) && data.priceInr >= 50 && data.priceInr <= 100000 &&
        data.deliveryDays is int && data.deliveryDays >= 1 && data.deliveryDays <= 60 &&
        data.isActive is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFreelanceOrder(data) {
      return data.gigId is string && isValidId(data.gigId) &&
        data.buyerId is string && data.buyerId.size() >= 1 && data.buyerId.size() <= 128 &&
        data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128 &&
        data.buyerId != data.sellerId &&
        (data.grossAmountInr is int || data.grossAmountInr is float) && data.grossAmountInr > 0 &&
        (data.platformCommissionInr is int || data.platformCommissionInr is float) && data.platformCommissionInr >= 0 &&
        (data.sellerNetInr is int || data.sellerNetInr is float) && data.sellerNetInr >= 0 &&
        data.requirements is string && data.requirements.size() >= 3 && data.requirements.size() <= 1000 &&
        isValidOptionalString(data, 'deliveryNote', 1000) &&
        data.status in ['PLACED', 'IN_PROGRESS', 'DELIVERED', 'COMPLETED', 'DISPUTED', 'CANCELLED'] &&
        data.isTestMode is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidProduct(data) {
      return data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128 &&
        data.sellerName is string && data.sellerName.size() >= 2 && data.sellerName.size() <= 80 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1200 &&
        (data.priceInr is int || data.priceInr is float) && data.priceInr >= 10 && data.priceInr <= 100000 &&
        data.stock is int && data.stock >= 0 && data.stock <= 100000 &&
        data.isActive is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidProductOrder(data) {
      return data.productId is string && isValidId(data.productId) &&
        data.buyerId is string && data.buyerId.size() >= 1 && data.buyerId.size() <= 128 &&
        data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128 &&
        data.buyerId != data.sellerId &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 100 &&
        (data.grossAmountInr is int || data.grossAmountInr is float) && data.grossAmountInr > 0 &&
        (data.platformCommissionInr is int || data.platformCommissionInr is float) && data.platformCommissionInr >= 0 &&
        (data.sellerNetInr is int || data.sellerNetInr is float) && data.sellerNetInr >= 0 &&
        data.shippingArea is string && data.shippingArea.size() >= 3 && data.shippingArea.size() <= 160 &&
        data.trackingStatus in ['ORDERED', 'PACKED', 'SHIPPED', 'DELIVERED', 'COMPLETED', 'CANCELLED'] &&
        data.isTestMode is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAffiliateOffer(data) {
      return data.merchantName is string && data.merchantName.size() >= 2 && data.merchantName.size() <= 80 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
        data.baseUrl is string && data.baseUrl.size() >= 8 && data.baseUrl.size() <= 300 &&
        (data.totalCommissionPercent is int || data.totalCommissionPercent is float) && data.totalCommissionPercent > 0 && data.totalCommissionPercent <= 50 &&
        (data.userSharePercent is int || data.userSharePercent is float) && data.userSharePercent > 0 && data.userSharePercent <= 95 &&
        data.isActive is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidAffiliateEvent(data) {
      return data.offerId is string && isValidId(data.offerId) &&
        data.promoterUid is string && data.promoterUid.size() >= 1 && data.promoterUid.size() <= 128 &&
        data.trackingCode is string && data.trackingCode.size() >= 4 && data.trackingCode.size() <= 80 &&
        data.status in ['CLICKED', 'VERIFIED_SALE', 'REJECTED'] &&
        (data.saleAmountInr is int || data.saleAmountInr is float) && data.saleAmountInr >= 0 &&
        (data.grossCommissionInr is int || data.grossCommissionInr is float) && data.grossCommissionInr >= 0 &&
        (data.userPayoutInr is int || data.userPayoutInr is float) && data.userPayoutInr >= 0 &&
        (data.platformNetInr is int || data.platformNetInr is float) && data.platformNetInr >= 0 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidReferral(data) {
      return data.referrerUid is string && data.referrerUid.size() >= 1 && data.referrerUid.size() <= 128 &&
        data.refereeUid is string && data.refereeUid.size() >= 1 && data.refereeUid.size() <= 128 &&
        data.referrerUid != data.refereeUid &&
        data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 24 &&
        data.status in ['SIGNED_UP', 'ELIGIBLE_ACTIVITY_DONE', 'REWARDED', 'FLAGGED'] &&
        (data.rewardInr is int || data.rewardInr is float) && data.rewardInr >= 0 && data.rewardInr <= 500 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidTutorCourse(data) {
      return data.tutorId is string && data.tutorId.size() >= 1 && data.tutorId.size() <= 128 &&
        data.tutorName is string && data.tutorName.size() >= 2 && data.tutorName.size() <= 80 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        (data.hourlyRateInr is int || data.hourlyRateInr is float) && data.hourlyRateInr >= 50 && data.hourlyRateInr <= 25000 &&
        data.mode in ['LIVE_1ON1', 'COHORT_CLASS', 'SKILL_COURSE'] &&
        data.isActive is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidTutorBooking(data) {
      return data.courseId is string && isValidId(data.courseId) &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
        data.tutorId is string && data.tutorId.size() >= 1 && data.tutorId.size() <= 128 &&
        data.studentId != data.tutorId &&
        data.scheduledSlot is string && data.scheduledSlot.size() >= 3 && data.scheduledSlot.size() <= 80 &&
        (data.grossAmountInr is int || data.grossAmountInr is float) && data.grossAmountInr > 0 &&
        (data.platformCommissionInr is int || data.platformCommissionInr is float) && data.platformCommissionInr >= 0 &&
        (data.tutorNetInr is int || data.tutorNetInr is float) && data.tutorNetInr >= 0 &&
        data.status in ['BOOKED', 'CONFIRMED', 'COMPLETED', 'CANCELLED'] &&
        data.isTestMode is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidLocalService(data) {
      return data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128 &&
        data.providerName is string && data.providerName.size() >= 2 && data.providerName.size() <= 80 &&
        data.serviceType is string && data.serviceType.size() >= 2 && data.serviceType.size() <= 60 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        (data.rateInr is int || data.rateInr is float) && data.rateInr >= 50 && data.rateInr <= 50000 &&
        data.isActive is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidServiceBooking(data) {
      return data.serviceId is string && isValidId(data.serviceId) &&
        data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 128 &&
        data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128 &&
        data.customerId != data.providerId &&
        data.cityArea is string && data.cityArea.size() >= 2 && data.cityArea.size() <= 120 &&
        isValidOptionalString(data, 'notes', 500) &&
        (data.grossAmountInr is int || data.grossAmountInr is float) && data.grossAmountInr > 0 &&
        (data.platformCommissionInr is int || data.platformCommissionInr is float) && data.platformCommissionInr >= 0 &&
        (data.providerNetInr is int || data.providerNetInr is float) && data.providerNetInr >= 0 &&
        data.customerConfirmed is bool &&
        data.status in ['REQUESTED', 'ACCEPTED', 'WORK_DONE', 'COMPLETED', 'CANCELLED'] &&
        data.isTestMode is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidDisputeRefund(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.relatedOrderId is string && data.relatedOrderId.size() >= 1 && data.relatedOrderId.size() <= 128 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 40 &&
        data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 1000 &&
        (data.requestedRefundInr is int || data.requestedRefundInr is float) && data.requestedRefundInr > 0 &&
        data.status in ['OPEN', 'UNDER_REVIEW', 'REFUNDED', 'REJECTED'] &&
        isValidOptionalString(data, 'adminResolutionNote', 500) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidSupportTicket(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 120 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 1000 &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 40 &&
        data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
        isValidOptionalString(data, 'adminReply', 500) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.targetPath is string && data.targetPath.size() >= 1 && data.targetPath.size() <= 200 &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 400 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidFraudFlag(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300 &&
        data.severity in ['LOW', 'MEDIUM', 'HIGH'] &&
        data.status in ['OPEN', 'CLEARED', 'BLOCKED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidReferralCodeLookup(data) {
      return data.code is string && data.code.size() >= 4 && data.code.size() <= 24 &&
        data.code.matches('^[A-Z0-9]+$') &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidDailyCheckIn(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        (data.requestedBonusInr is int || data.requestedBonusInr is float) && data.requestedBonusInr > 0 && data.requestedBonusInr <= 100 &&
        data.status in ['PENDING_ADMIN_FUNDING', 'APPROVED_TEST', 'REJECTED'] &&
        isValidOptionalString(data, 'reviewNote', 240) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (request.auth != null && (request.auth.uid == adminUid || isAdmin()));
      allow list: if isAdmin();
      allow create, update: if isValidId(adminUid) && isAdmin() && isValidAdminMarker(incoming());
      allow delete: if isValidId(adminUid) && isBootstrappedAdmin();
    }

    match /referral_codes/{code} {
      allow get: if isValidId(code) && isSignedIn();
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(code) && isSignedIn() &&
        isValidReferralCodeLookup(incoming()) &&
        incoming().code == code &&
        incoming().ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isValidId(userId) && isSignedIn() &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().role == 'USER' &&
        incoming().isVerified == false &&
        incoming().kycStatus == 'UNVERIFIED' &&
        incoming().keys().hasAll(['userId', 'displayName', 'email', 'role', 'referralCode', 'isVerified', 'kycStatus', 'preferredLanguage', 'consentAccepted', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'displayName', 'email', 'phone', 'role', 'referralCode', 'referredByUid', 'isVerified', 'kycStatus', 'preferredLanguage', 'consentAccepted', 'createdAt', 'updatedAt']);

      allow update: if isValidId(userId) && isSignedIn() && isValidUserProfile(incoming()) && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().role == existing().role &&
          incoming().isVerified == existing().isVerified &&
          incoming().kycStatus == existing().kycStatus &&
          incoming().referralCode == existing().referralCode &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'preferredLanguage', 'consentAccepted', 'updatedAt'])
        )
      );

      allow delete: if false;
    }

    match /wallets/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      // Users can initialize their own wallet ONLY with exact zero balances
      allow create: if isValidId(userId) && isSignedIn() &&
        request.auth.uid == userId &&
        isValidWallet(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().availableBalanceInr == 0 &&
        incoming().pendingBalanceInr == 0 &&
        incoming().totalEarnedInr == 0 &&
        incoming().totalWithdrawnInr == 0 &&
        incoming().completedTasksCount == 0 &&
        incoming().activeProjectsCount == 0 &&
        incoming().keys().hasAll(['userId', 'availableBalanceInr', 'pendingBalanceInr', 'totalEarnedInr', 'totalWithdrawnInr', 'completedTasksCount', 'activeProjectsCount', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'availableBalanceInr', 'pendingBalanceInr', 'totalEarnedInr', 'totalWithdrawnInr', 'completedTasksCount', 'activeProjectsCount', 'createdAt', 'updatedAt']);

      // CRITICAL SECURITY INVARIANT: Users can NEVER modify their own wallet balance!
      allow update: if isValidId(userId) && isAdmin() && isValidWallet(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;

      allow delete: if false;
    }

    match /ledger_transactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      allow create: if isValidId(txId) && isAdmin() && isValidLedgerTransaction(incoming()) &&
        incoming().keys().hasAll(['userId', 'type', 'category', 'grossAmountInr', 'platformCommissionInr', 'gatewayFeeInr', 'netAmountInr', 'status', 'referenceId', 'idempotencyKey', 'description', 'isTestMode', 'createdAt']) &&
